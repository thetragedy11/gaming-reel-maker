# ============================================================
# GAMING REEL MAKER — Environment Variables
# Copy this file to .env and fill in your keys
# NEVER commit .env to GitHub!
# ============================================================

# --- AI Script Generation ---
GEMINI_API_KEY=your_gemini_api_key_here
# OR use OpenAI instead:
# OPENAI_API_KEY=your_openai_api_key_here

# --- ElevenLabs (Voiceover) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Default: Rachel voice

# --- Pexels (Stock Footage) ---
PEXELS_API_KEY=your_pexels_api_key_here

# --- Instagram ---
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_account_id_here

# --- YouTube ---
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here
